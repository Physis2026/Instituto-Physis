# Physis Fatiador (Physis 3D, em desenvolvimento). Copiado para env/fatiador.env pelo preparar.sh (0600).
# Chave compartilhada com o hub (PHYSIS_FATIADOR_CHAVE no env/hub.env). Gere com: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
PHYSIS_FATIADOR_CHAVE=
# Tamanho da mesa da impressora em mm (largura x profundidade)
PHYSIS_FATIADOR_MESA=220x220
# Tempo máximo de um fatiamento (segundos) e quantos ao mesmo tempo
PHYSIS_FATIADOR_TEMPO=240
PHYSIS_FATIADOR_SIMULTANEOS=1
