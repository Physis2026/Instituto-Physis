# Copiado para servicos/.env por preparar.sh. Sem segredos aqui (eles ficam em env/*.env).
COMPOSE_PROJECT_NAME=physis
# perfis: hub caddy mosquitto nodered superset bi geoserver series calc documentos ia ia-vllm
COMPOSE_PROFILES=hub,caddy
PHYSIS_DADOS=/srv/physis
# pasta do pacote montado do servidor (montar.py ... --gestao ...), ou ../physis-hub em desenvolvimento
PHYSIS_PACOTE=../physis-hub
