# Modelo de /etc/physis/backup.env (0600 root). Lido por backup.sh e restaurar.sh.

# Pasta de destino. Pendrive: monte sempre no mesmo lugar (fstab com UUID e "nofail").
# Se DESTINO_EXIGE_MONTAGEM=1 e o pendrive não estiver montado, a cópia falha (não enche o cartão SD).
DESTINO=/media/physis-backup
DESTINO_EXIGE_MONTAGEM=1

# Cifra: "age" (recomendado: o aparelho guarda só a chave PÚBLICA; quem restaura tem a privada, fora dele)
# ou "openssl" (AES-256-CBC + PBKDF2, senha num arquivo 0600 do próprio aparelho; mais fraco: veja IMPLANTACAO.md).
CIFRA=age
# chave pública age (age1...) — gere com: age-keygen -o physis-backup.chave  (guarde a .chave FORA do aparelho)
AGE_DESTINATARIO=
# arquivo com a senha do openssl (só se CIFRA=openssl). Gere com: python3 -c 'import secrets;print(secrets.token_urlsafe(32))'
OPENSSL_SENHA_ARQUIVO=/etc/physis/backup.senha

# Retenção: diárias, semanais (domingo) e mensais (dia 1)
MANTER_DIARIAS=7
MANTER_SEMANAIS=4
MANTER_MENSAIS=12

# Cópia remota (opcional): rsync por SSH com chave dedicada (sem senha no script)
# Ex.: RSYNC_DESTINO=backup@servidor.physis:/srv/backups/fazenda-x
RSYNC_DESTINO=
RSYNC_CHAVE_SSH=/etc/physis/backup_ed25519
