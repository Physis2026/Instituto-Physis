# Modelo de /etc/physis/physis.env (o instalar.sh cria o arquivo de verdade, 0640 root:physis).
# Segredos ficam VAZIOS aqui: o instalar.sh gera com python3 -m secrets. Nunca versione o arquivo real.
# Todas as variáveis: physis-hub/docs/SEGURANCA.md e physis-hub/docs/IMPLANTACAO.md.

PHYSIS_BANCO=/var/lib/physis/physis-hub.db
PHYSIS_PORTA=8700
# 0.0.0.0 na rede local (o receptor V6 entrega em http://<pi>:8700); 127.0.0.1 atrás do Caddy na internet
PHYSIS_ENDERECO=0.0.0.0
PHYSIS_MAPAS=/var/lib/physis/mapas
PHYSIS_ENTREGAS=/var/lib/physis/entregas
PHYSIS_EDITAIS_PASTA=/var/lib/physis/editais
PYTHONDONTWRITEBYTECODE=1

# Receptor V6 (opcional): http://<ip do receptor>
PHYSIS_RX_URL=

# Com Caddy (instalar.sh --caddy ...)
PHYSIS_PROXY_CONFIAVEL=
PHYSIS_HTTPS=
PHYSIS_EXPOSTO=
PHYSIS_URL_PUBLICA=
PHYSIS_ACEITAR_SEM_CHAVE=

# MQTT da Caixinha (instalar.sh --mosquitto). A senha é gerada pelo instalador.
PHYSIS_MQTT_BROKER=
PHYSIS_MQTT_PORTA=
PHYSIS_MQTT_USUARIO=
PHYSIS_MQTT_SENHA=
PHYSIS_MQTT_NOS=

# E-mail (lista do Eric, parte C). Sem isso as mensagens ficam na fila.
PHYSIS_SMTP_HOST=
PHYSIS_SMTP_PORTA=
PHYSIS_SMTP_USUARIO=
PHYSIS_SMTP_SENHA=
PHYSIS_SMTP_REMETENTE=

# Serviços do servidor da Physis (opcionais; o hub funciona sem eles). servicos/ e docs/SERVICOS_ABERTOS.md
PHYSIS_CALC_URL=
PHYSIS_CALC_CHAVE=
PHYSIS_IA_URL=
PHYSIS_IA_TIPO=
PHYSIS_IA_MODELO=
PHYSIS_IA_CHAVE=
